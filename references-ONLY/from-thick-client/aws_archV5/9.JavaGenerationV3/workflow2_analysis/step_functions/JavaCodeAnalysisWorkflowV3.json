{
  "Comment": "Java Generation V3 - Code Analysis Workflow (Flow 2)",
  "StartAt": "ValidateJavaCode",
  "States": {
    "ValidateJavaCode": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:376129851858:function:ValidationEngineV3",
        "Payload": {
          "job_id.$": "$.job_id",
          "scout_account_id.$": "$.scout_account_id",
          "application_name.$": "$.application_name"
        }
      },
      "ResultPath": "$.validation_result",
      "ResultSelector": {
        "validation_passed.$": "$.Payload.validation_passed",
        "total_files.$": "$.Payload.total_files",
        "files_with_errors.$": "$.Payload.files_with_errors",
        "report_key.$": "$.Payload.report_key"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "ValidationFailed"
        }
      ],
      "Next": "CheckValidationResult"
    },
    "CheckValidationResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.validation_result.validation_passed",
          "BooleanEquals": true,
          "Next": "UpdateStatusComplete"
        }
      ],
      "Default": "UpdateStatusCompleteWithErrors"
    },
    "UpdateStatusComplete": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "code-transformation-v3",
        "Key.$": "States.Format('{}/{}/java_generation_v3/jobs/{}/status.json', $.scout_account_id, $.application_name, $.job_id)",
        "Body": {
          "state": "completed",
          "status": "completed",
          "progress": 100,
          "phase": "validation_complete",
          "message": "Java code validation completed successfully - all checks passed",
          "completed_at.$": "$$.State.EnteredTime"
        }
      },
      "Next": "ValidationPassed",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ]
    },
    "UpdateStatusCompleteWithErrors": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "code-transformation-v3",
        "Key.$": "States.Format('{}/{}/java_generation_v3/jobs/{}/status.json', $.scout_account_id, $.application_name, $.job_id)",
        "Body": {
          "state": "completed",
          "status": "completed_with_errors",
          "progress": 100,
          "phase": "validation_complete",
          "message": "Java code validation completed with errors - review report for details",
          "completed_at.$": "$$.State.EnteredTime"
        }
      },
      "Next": "ValidationHasErrors",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ]
    },
    "ValidationPassed": {
      "Type": "Succeed",
      "Comment": "All Java code validated successfully"
    },
    "ValidationHasErrors": {
      "Type": "Succeed",
      "Comment": "Validation completed with errors - proceed to Flow 3 to fix"
    },
    "ValidationFailed": {
      "Type": "Fail",
      "Error": "ValidationError",
      "Cause": "Java code validation failed with unexpected error"
    }
  }
}
