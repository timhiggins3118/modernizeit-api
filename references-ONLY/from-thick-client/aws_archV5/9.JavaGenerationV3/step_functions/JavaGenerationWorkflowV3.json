{
  "Comment": "Java Generation V3 Workflow - Enterprise Tools",
  "StartAt": "PrepareGeneration",
  "States": {
    "PrepareGeneration": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:376129851858:function:PrepareGenerationV3",
      "ResultPath": "$.preparation_result",
      "Next": "ProjectSetup",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failed"
        }
      ]
    },
    "ProjectSetup": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:376129851858:function:ProjectSetupV3",
      "ResultPath": "$.project_setup_result",
      "Next": "ParallelGeneration",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failed"
        }
      ]
    },
    "ParallelGeneration": {
      "Type": "Parallel",
      "ResultPath": "$.parallel_results",
      "Next": "UpdateStatusComplete",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Failed"
        }
      ],
      "Branches": [
        {
          "StartAt": "GenerateEntities",
          "States": {
            "GenerateEntities": {
              "Type": "Task",
              "Resource": "arn:aws:lambda:us-east-1:376129851858:function:EntityGeneratorV3",
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ]
            }
          }
        },
        {
          "StartAt": "GenerateServices",
          "States": {
            "GenerateServices": {
              "Type": "Task",
              "Resource": "arn:aws:lambda:us-east-1:376129851858:function:ServiceGeneratorV3",
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ]
            }
          }
        },
        {
          "StartAt": "GenerateRepositories",
          "States": {
            "GenerateRepositories": {
              "Type": "Task",
              "Resource": "arn:aws:lambda:us-east-1:376129851858:function:RepositoryGeneratorV3",
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ]
            }
          }
        },
        {
          "StartAt": "GenerateAPIs",
          "States": {
            "GenerateAPIs": {
              "Type": "Task",
              "Resource": "arn:aws:lambda:us-east-1:376129851858:function:APIGeneratorV3",
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ]
            }
          }
        },
        {
          "StartAt": "GenerateTests",
          "States": {
            "GenerateTests": {
              "Type": "Task",
              "Resource": "arn:aws:lambda:us-east-1:376129851858:function:TestGeneratorV3",
              "End": true,
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ]
            }
          }
        }
      ]
    },
    "UpdateStatusComplete": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "code-transformation-v3",
        "Key.$": "States.Format('{}/{}/java_generation_v3/jobs/{}/status.json', $.scout_account_id, $.application_name, $.job_id)",
        "Body": {
          "state": "completed",
          "status": "completed",
          "progress": 100,
          "phase": "completed",
          "message": "Java generation completed successfully",
          "completed_at.$": "$$.State.EnteredTime"
        }
      },
      "Next": "Success",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ]
    },
    "Success": {
      "Type": "Succeed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "WorkflowFailed",
      "Cause": "Java Generation V3 workflow failed"
    }
  }
}
