{
  "Comment": "Code Analysis V2 Workflow - With AI Batching for Scale",
  "StartAt": "CaptureStartTime",
  "States": {
    "CaptureStartTime": {
      "Type": "Pass",
      "Comment": "Capture workflow start time",
      "Parameters": {
        "started_at.$": "$$.State.EnteredTime"
      },
      "ResultPath": "$.workflow_metadata",
      "Next": "UpdateStatusRunning"
    },
    "UpdateStatusRunning": {
      "Type": "Task",
      "Comment": "Update job status to running",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "code-transformation-v2",
        "Key.$": "States.Format('{}/{}/code_analysis_v2/jobs/{}/status.json', $.scout_account_id, $.application_name, $.job_id)",
        "Body": {
          "state": "running",
          "started_at.$": "$.workflow_metadata.started_at",
          "phase": "static_analysis",
          "message": "Running static code analysis..."
        },
        "ContentType": "application/json"
      },
      "ResultPath": "$.status_update_result",
      "Next": "ParallelAnalysis"
    },
    "ParallelAnalysis": {
      "Type": "Parallel",
      "Comment": "Run Regex, Tree-Sitter, and AI analyzers in parallel",
      "Branches": [
        {
          "StartAt": "RegexAnalyzer",
          "States": {
            "RegexAnalyzer": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "CodeAnalysisV2RegexAnalyzer",
                "Payload": {
                  "job_id.$": "$.job_id",
                  "scout_account_id.$": "$.scout_account_id",
                  "application_name.$": "$.application_name",
                  "source_hash.$": "$.source_hash"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "TreeSitterAnalyzer",
          "States": {
            "TreeSitterAnalyzer": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "CodeAnalysisV2TreeSitterAnalyzer",
                "Payload": {
                  "job_id.$": "$.job_id",
                  "scout_account_id.$": "$.scout_account_id",
                  "application_name.$": "$.application_name",
                  "source_hash.$": "$.source_hash"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "PrepareAIBatches",
          "States": {
            "PrepareAIBatches": {
              "Type": "Task",
              "Comment": "Split files into batches for AI analysis",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "CodeAnalysisV2PrepareAIBatches",
                "Payload": {
                  "job_id.$": "$.job_id",
                  "scout_account_id.$": "$.scout_account_id",
                  "application_name.$": "$.application_name",
                  "source_hash.$": "$.source_hash"
                }
              },
              "ResultPath": "$.batch_preparation",
              "Next": "CheckBatchCount"
            },
            "CheckBatchCount": {
              "Type": "Choice",
              "Comment": "Check if there are batches to process",
              "Choices": [
                {
                  "Variable": "$.batch_preparation.Payload.body.total_batches",
                  "NumericGreaterThan": 0,
                  "Next": "AIAnalyzerMap"
                }
              ],
              "Default": "SkipAIAnalysis"
            },
            "AIAnalyzerMap": {
              "Type": "Map",
              "Comment": "Process AI batches in parallel",
              "MaxConcurrency": 40,
              "ItemsPath": "$.batch_preparation.Payload.body.batches",
              "Parameters": {
                "job_id.$": "$.job_id",
                "scout_account_id.$": "$.scout_account_id",
                "application_name.$": "$.application_name",
                "source_hash.$": "$.source_hash",
                "batch.$": "$$.Map.Item.Value"
              },
              "Iterator": {
                "StartAt": "ProcessBatch",
                "States": {
                  "ProcessBatch": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::lambda:invoke",
                    "Parameters": {
                      "FunctionName": "CodeAnalysisV2BedrockAnalyzerBatch",
                      "Payload.$": "$"
                    },
                    "Retry": [
                      {
                        "ErrorEquals": [
                          "States.ALL"
                        ],
                        "IntervalSeconds": 5,
                        "MaxAttempts": 3,
                        "BackoffRate": 2.0
                      }
                    ],
                    "End": true
                  }
                }
              },
              "ResultPath": "$.batch_results",
              "Next": "MergeAIBatches"
            },
            "MergeAIBatches": {
              "Type": "Task",
              "Comment": "Merge all AI batch results",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "CodeAnalysisV2MergeAIBatches",
                "Payload": {
                  "job_id.$": "$.job_id",
                  "scout_account_id.$": "$.scout_account_id",
                  "application_name.$": "$.application_name",
                  "source_hash.$": "$.source_hash",
                  "total_batches.$": "$.batch_preparation.Payload.body.total_batches",
                  "total_files.$": "$.batch_preparation.Payload.body.total_files"
                }
              },
              "End": true
            },
            "SkipAIAnalysis": {
              "Type": "Pass",
              "Comment": "No files to analyze with AI",
              "Result": {
                "statusCode": 200,
                "body": {
                  "status": "skipped",
                  "message": "No COBOL files for AI analysis"
                }
              },
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.parallel_results",
      "Next": "MergeAnalysis",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "HandleAnalysisError",
          "ResultPath": "$.error"
        }
      ]
    },
    "MergeAnalysis": {
      "Type": "Task",
      "Comment": "Merge regex, AST, and AI analysis results",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "CodeAnalysisV2MergeAnalysis",
        "Payload": {
          "job_id.$": "$.job_id",
          "scout_account_id.$": "$.scout_account_id",
          "application_name.$": "$.application_name",
          "source_hash.$": "$.source_hash",
          "regex_status": "completed",
          "ast_status": "completed",
          "ai_status": "completed"
        }
      },
      "ResultPath": "$.merge_result",
      "Next": "UpdateStatusCompleted",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "HandleMergeError",
          "ResultPath": "$.error"
        }
      ]
    },
    "UpdateStatusCompleted": {
      "Type": "Task",
      "Comment": "Update job status to completed",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "code-transformation-v2",
        "Key.$": "States.Format('{}/{}/code_analysis_v2/jobs/{}/status.json', $.scout_account_id, $.application_name, $.job_id)",
        "Body": {
          "state": "completed",
          "started_at.$": "$.workflow_metadata.started_at",
          "completed_at.$": "$$.State.EnteredTime",
          "phase": "completed",
          "message": "Static analysis completed successfully",
          "outputs": {
            "static_analysis.$": "$.merge_result.Payload.body.output_path"
          }
        },
        "ContentType": "application/json"
      },
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed",
      "Comment": "Workflow completed successfully"
    },
    "HandleAnalysisError": {
      "Type": "Task",
      "Comment": "Handle analysis failure",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "code-transformation-v2",
        "Key.$": "States.Format('{}/{}/code_analysis_v2/jobs/{}/status.json', $.scout_account_id, $.application_name, $.job_id)",
        "Body": {
          "state": "failed",
          "started_at.$": "$.workflow_metadata.started_at",
          "failed_at.$": "$$.State.EnteredTime",
          "phase": "static_analysis",
          "error_type": "analysis_error",
          "error.$": "$.error"
        },
        "ContentType": "application/json"
      },
      "Next": "Failure"
    },
    "HandleMergeError": {
      "Type": "Task",
      "Comment": "Handle merge failure",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "code-transformation-v2",
        "Key.$": "States.Format('{}/{}/code_analysis_v2/jobs/{}/status.json', $.scout_account_id, $.application_name, $.job_id)",
        "Body": {
          "state": "failed",
          "started_at.$": "$.workflow_metadata.started_at",
          "failed_at.$": "$$.State.EnteredTime",
          "phase": "merge_analysis",
          "error_type": "merge_error",
          "error.$": "$.error"
        },
        "ContentType": "application/json"
      },
      "Next": "Failure"
    },
    "Failure": {
      "Type": "Fail",
      "Comment": "Workflow failed"
    }
  }
}