{
  "Comment": "Dependency Mapper V2 Workflow - COBOL Dependency Analysis and Microservice Planning",
  "StartAt": "CaptureStartTime",
  "States": {
    "CaptureStartTime": {
      "Type": "Pass",
      "Comment": "Capture workflow start time",
      "Parameters": {
        "started_at.$": "$$.State.EnteredTime"
      },
      "ResultPath": "$.workflow_metadata",
      "Next": "UpdateStatusRunning"
    },
    "UpdateStatusRunning": {
      "Type": "Task",
      "Comment": "Update job status to running",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "code-transformation-v2",
        "Key.$": "States.Format('{}/{}/dependency_mapper_v2/jobs/{}/status.json', $.scout_account_id, $.application_name, $.job_id)",
        "Body": {
          "state": "running",
          "started_at.$": "$.workflow_metadata.started_at",
          "phase": "initializing",
          "progress": 5,
          "message": "Starting dependency analysis..."
        },
        "ContentType": "application/json"
      },
      "ResultPath": "$.status_update_result",
      "Next": "PrepareAnalysis"
    },
    "PrepareAnalysis": {
      "Type": "Task",
      "Comment": "Prepare COBOL files for dependency analysis",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DependencyMapperV2PrepareAnalysis",
        "Payload": {
          "job_id.$": "$.job_id",
          "scout_account_id.$": "$.scout_account_id",
          "application_name.$": "$.application_name",
          "source_hash.$": "$.source_hash"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultSelector": {
        "job_id.$": "$.Payload.job_id",
        "scout_account_id.$": "$.Payload.scout_account_id",
        "application_name.$": "$.Payload.application_name",
        "source_hash.$": "$.Payload.source_hash",
        "total_files.$": "$.Payload.total_files",
        "total_batches.$": "$.Payload.total_batches",
        "batches.$": "$.Payload.batches"
      },
      "ResultPath": "$.preparation",
      "Next": "StaticAnalysisMap"
    },
    "StaticAnalysisMap": {
      "Type": "Map",
      "Comment": "Process each batch in parallel for static dependency parsing",
      "ItemsPath": "$.preparation.batches",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "StaticParser",
        "States": {
          "StaticParser": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "DependencyMapperV2StaticParser",
              "Payload": {
                "job_id.$": "$.job_id",
                "scout_account_id.$": "$.scout_account_id",
                "application_name.$": "$.application_name",
                "source_hash.$": "$.source_hash",
                "batch.$": "$.batch"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "End": true
          }
        }
      },
      "MaxConcurrency": 40,
      "ResultPath": "$.static_map_results",
      "Next": "MergeStaticAnalysis"
    },
    "MergeStaticAnalysis": {
      "Type": "Task",
      "Comment": "Merge all static analysis batch results",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DependencyMapperV2MergeStatic",
        "Payload": {
          "job_id.$": "$.preparation.job_id",
          "scout_account_id.$": "$.preparation.scout_account_id",
          "application_name.$": "$.preparation.application_name",
          "total_batches.$": "$.preparation.total_batches"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultSelector": {
        "merged_file.$": "$.Payload.merged_file",
        "total_programs.$": "$.Payload.total_programs"
      },
      "ResultPath": "$.merge_result",
      "Next": "AIDeepAnalysis"
    },
    "AIDeepAnalysis": {
      "Type": "Task",
      "Comment": "AI-powered deep dependency analysis",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DependencyMapperV2AIAnalyzer",
        "Payload": {
          "job_id.$": "$.preparation.job_id",
          "scout_account_id.$": "$.preparation.scout_account_id",
          "application_name.$": "$.preparation.application_name"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultPath": "$.ai_result",
      "Next": "BuildDependencyGraph"
    },
    "BuildDependencyGraph": {
      "Type": "Task",
      "Comment": "Build dependency graph from analysis",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DependencyMapperV2GraphBuilder",
        "Payload": {
          "job_id.$": "$.preparation.job_id",
          "scout_account_id.$": "$.preparation.scout_account_id",
          "application_name.$": "$.preparation.application_name"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultPath": "$.graph_result",
      "Next": "ParallelAnalysis"
    },
    "ParallelAnalysis": {
      "Type": "Parallel",
      "Comment": "Run coupling calculation and risk assessment in parallel",
      "Branches": [
        {
          "StartAt": "CouplingCalculator",
          "States": {
            "CouplingCalculator": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "DependencyMapperV2CouplingCalculator",
                "Payload": {
                  "job_id.$": "$.preparation.job_id",
                  "scout_account_id.$": "$.preparation.scout_account_id",
                  "application_name.$": "$.preparation.application_name"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "RiskAssessor",
          "States": {
            "RiskAssessor": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "DependencyMapperV2RiskAssessor",
                "Payload": {
                  "job_id.$": "$.preparation.job_id",
                  "scout_account_id.$": "$.preparation.scout_account_id",
                  "application_name.$": "$.preparation.application_name"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.parallel_results",
      "Next": "MicroserviceDetector"
    },
    "MicroserviceDetector": {
      "Type": "Task",
      "Comment": "Suggest microservice boundaries",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DependencyMapperV2MicroserviceDetector",
        "Payload": {
          "job_id.$": "$.preparation.job_id",
          "scout_account_id.$": "$.preparation.scout_account_id",
          "application_name.$": "$.preparation.application_name"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultPath": "$.microservice_result",
      "Next": "ImpactAnalyzer"
    },
    "ImpactAnalyzer": {
      "Type": "Task",
      "Comment": "Calculate impact analysis for each program",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DependencyMapperV2ImpactAnalyzer",
        "Payload": {
          "job_id.$": "$.preparation.job_id",
          "scout_account_id.$": "$.preparation.scout_account_id",
          "application_name.$": "$.preparation.application_name"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultPath": "$.impact_result",
      "Next": "UpdateStatusCompleted"
    },
    "UpdateStatusCompleted": {
      "Type": "Task",
      "Comment": "Mark job as completed",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "code-transformation-v2",
        "Key.$": "States.Format('{}/{}/dependency_mapper_v2/jobs/{}/status.json', $.preparation.scout_account_id, $.preparation.application_name, $.preparation.job_id)",
        "Body": {
          "state": "completed",
          "started_at.$": "$.workflow_metadata.started_at",
          "completed_at.$": "$$.State.EnteredTime",
          "phase": "completed",
          "progress": 100,
          "message": "Dependency analysis completed successfully"
        },
        "ContentType": "application/json"
      },
      "ResultPath": "$.final_status_update",
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed",
      "Comment": "Dependency Mapper V2 workflow completed successfully"
    }
  }
}