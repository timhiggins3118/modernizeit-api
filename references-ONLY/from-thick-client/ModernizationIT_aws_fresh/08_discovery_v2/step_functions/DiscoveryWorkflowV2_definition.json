{
  "Comment": "Discovery V2 Workflow - Business Process Discovery and Migration Planning",
  "StartAt": "CaptureStartTime",
  "States": {
    "CaptureStartTime": {
      "Type": "Pass",
      "Comment": "Capture workflow start time",
      "Parameters": {
        "started_at.$": "$$.State.EnteredTime"
      },
      "ResultPath": "$.workflow_metadata",
      "Next": "UpdateStatusRunning"
    },
    "UpdateStatusRunning": {
      "Type": "Task",
      "Comment": "Update job status to running",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "code-transformation-v2",
        "Key.$": "States.Format('{}/{}/discovery_v2/jobs/{}/status.json', $.scout_account_id, $.application_name, $.job_id)",
        "Body": {
          "state": "running",
          "started_at.$": "$.workflow_metadata.started_at",
          "phase": "discovery_analysis",
          "progress": 5,
          "message": "Starting discovery analysis..."
        },
        "ContentType": "application/json"
      },
      "ResultPath": "$.status_update_result",
      "Next": "PrepareDiscoveryBatches"
    },
    "PrepareDiscoveryBatches": {
      "Type": "Task",
      "Comment": "Split COBOL files into batches for AI discovery analysis",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DiscoveryV2PrepareDiscoveryBatches",
        "Payload": {
          "job_id.$": "$.job_id",
          "scout_account_id.$": "$.scout_account_id",
          "application_name.$": "$.application_name",
          "source_hash.$": "$.source_hash"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultSelector": {
        "job_id.$": "$.Payload.job_id",
        "scout_account_id.$": "$.Payload.scout_account_id",
        "application_name.$": "$.Payload.application_name",
        "source_hash.$": "$.Payload.source_hash",
        "total_files.$": "$.Payload.total_files",
        "total_batches.$": "$.Payload.total_batches",
        "batches.$": "$.Payload.batches"
      },
      "ResultPath": "$.batch_preparation",
      "Next": "CheckBatchCount"
    },
    "CheckBatchCount": {
      "Type": "Choice",
      "Comment": "Check if we have batches to process",
      "Choices": [
        {
          "Variable": "$.batch_preparation.total_batches",
          "NumericGreaterThan": 0,
          "Next": "DiscoveryAnalyzerMap"
        }
      ],
      "Default": "NoBatchesFound"
    },
    "NoBatchesFound": {
      "Type": "Fail",
      "Error": "NoBatchesError",
      "Cause": "No COBOL files found to analyze"
    },
    "DiscoveryAnalyzerMap": {
      "Type": "Map",
      "Comment": "Process each batch in parallel using Distributed Map",
      "ItemsPath": "$.batch_preparation.batches",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "BedrockDiscoveryAnalyzerBatch",
        "States": {
          "BedrockDiscoveryAnalyzerBatch": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "DiscoveryV2BedrockAnalyzerBatch",
              "Payload": {
                "job_id.$": "$.job_id",
                "scout_account_id.$": "$.scout_account_id",
                "application_name.$": "$.application_name",
                "source_hash.$": "$.source_hash",
                "batch.$": "$.batch"
              }
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "End": true
          }
        }
      },
      "MaxConcurrency": 40,
      "ResultPath": "$.discovery_map_results",
      "Next": "MergeDiscoveryBatches"
    },
    "MergeDiscoveryBatches": {
      "Type": "Task",
      "Comment": "Merge all batch results into single AI discovery analysis file",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DiscoveryV2MergeDiscoveryBatches",
        "Payload": {
          "job_id.$": "$.batch_preparation.job_id",
          "scout_account_id.$": "$.batch_preparation.scout_account_id",
          "application_name.$": "$.batch_preparation.application_name",
          "source_hash.$": "$.batch_preparation.source_hash",
          "total_batches.$": "$.batch_preparation.total_batches"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultSelector": {
        "merged_file.$": "$.Payload.merged_file",
        "total_files_analyzed.$": "$.Payload.total_files_analyzed"
      },
      "ResultPath": "$.merge_result",
      "Next": "ParallelEnrichment"
    },
    "ParallelEnrichment": {
      "Type": "Parallel",
      "Comment": "Extract business processes, integration points, and API patterns in parallel",
      "Branches": [
        {
          "StartAt": "BusinessProcessExtractor",
          "States": {
            "BusinessProcessExtractor": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "DiscoveryV2BusinessProcessExtractor",
                "Payload": {
                  "job_id.$": "$.batch_preparation.job_id",
                  "scout_account_id.$": "$.batch_preparation.scout_account_id",
                  "application_name.$": "$.batch_preparation.application_name"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "IntegrationDetector",
          "States": {
            "IntegrationDetector": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "DiscoveryV2IntegrationDetector",
                "Payload": {
                  "job_id.$": "$.batch_preparation.job_id",
                  "scout_account_id.$": "$.batch_preparation.scout_account_id",
                  "application_name.$": "$.batch_preparation.application_name"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        },
        {
          "StartAt": "APIPatternAnalyzer",
          "States": {
            "APIPatternAnalyzer": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "DiscoveryV2APIPatternAnalyzer",
                "Payload": {
                  "job_id.$": "$.batch_preparation.job_id",
                  "scout_account_id.$": "$.batch_preparation.scout_account_id",
                  "application_name.$": "$.batch_preparation.application_name"
                }
              },
              "Retry": [
                {
                  "ErrorEquals": [
                    "States.ALL"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.enrichment_results",
      "Next": "ROICalculator"
    },
    "ROICalculator": {
      "Type": "Task",
      "Comment": "Calculate ROI and cost savings",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DiscoveryV2ROICalculator",
        "Payload": {
          "job_id.$": "$.batch_preparation.job_id",
          "scout_account_id.$": "$.batch_preparation.scout_account_id",
          "application_name.$": "$.batch_preparation.application_name"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultPath": "$.roi_result",
      "Next": "RoadmapGenerator"
    },
    "RoadmapGenerator": {
      "Type": "Task",
      "Comment": "Generate phased migration roadmap",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "DiscoveryV2RoadmapGenerator",
        "Payload": {
          "job_id.$": "$.batch_preparation.job_id",
          "scout_account_id.$": "$.batch_preparation.scout_account_id",
          "application_name.$": "$.batch_preparation.application_name"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "ResultPath": "$.roadmap_result",
      "Next": "UpdateStatusCompleted"
    },
    "UpdateStatusCompleted": {
      "Type": "Task",
      "Comment": "Mark job as completed",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "code-transformation-v2",
        "Key.$": "States.Format('{}/{}/discovery_v2/jobs/{}/status.json', $.batch_preparation.scout_account_id, $.batch_preparation.application_name, $.batch_preparation.job_id)",
        "Body": {
          "state": "completed",
          "started_at.$": "$.workflow_metadata.started_at",
          "completed_at.$": "$$.State.EnteredTime",
          "phase": "completed",
          "progress": 100,
          "message": "Discovery analysis completed successfully"
        },
        "ContentType": "application/json"
      },
      "ResultPath": "$.final_status_update",
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed",
      "Comment": "Discovery V2 workflow completed successfully"
    }
  }
}