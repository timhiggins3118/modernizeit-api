#!/bin/bash

set -e

echo "================================================"
echo "  Starting {{APPLICATION_NAME}}"
echo "================================================"
echo ""

# Colors for pretty output
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if Docker is installed
echo -n "Checking Docker installation... "
if ! command -v docker &> /dev/null; then
    echo -e "${RED}✗${NC}"
    echo ""
    echo "Docker is not installed!"
    echo "Please install Docker Desktop from: https://www.docker.com/products/docker-desktop"
    exit 1
fi
echo -e "${GREEN}✓${NC}"

# Check if Docker is running
echo -n "Checking if Docker is running... "
if ! docker info &> /dev/null; then
    echo -e "${RED}✗${NC}"
    echo ""
    echo "Docker is installed but not running!"
    echo "Please start Docker Desktop and try again."
    exit 1
fi
echo -e "${GREEN}✓${NC}"

# Check if docker-compose is available
echo -n "Checking Docker Compose... "
if ! docker compose version &> /dev/null; then
    if ! command -v docker-compose &> /dev/null; then
        echo -e "${RED}✗${NC}"
        echo ""
        echo "Docker Compose is not available!"
        echo "Please update Docker Desktop to the latest version."
        exit 1
    fi
    COMPOSE_CMD="docker-compose"
else
    COMPOSE_CMD="docker compose"
fi
echo -e "${GREEN}✓${NC}"

# Check if image exists
APP_IMAGE="modernized-app:latest"
echo -n "Checking if image exists... "
if docker image inspect $APP_IMAGE &> /dev/null; then
    echo -e "${GREEN}✓ (using cached image)${NC}"
    REBUILD=false
else
    echo -e "${YELLOW}✗ (will build)${NC}"
    REBUILD=true
fi

# Build if needed
if [ "$REBUILD" = true ]; then
    echo ""
    echo "Building Docker image (first time, may take 5-10 minutes)..."
    echo "This will be cached for future runs."
    echo ""
    docker build -t $APP_IMAGE .
    echo ""
    echo -e "${GREEN}✓ Image built successfully${NC}"
fi

# Start services
echo ""
echo "Starting services (application + database)..."
$COMPOSE_CMD up -d

# Wait for services to be healthy
echo ""
echo -n "Waiting for application to start"
MAX_ATTEMPTS=30
ATTEMPT=0
while [ $ATTEMPT -lt $MAX_ATTEMPTS ]; do
    if curl -s http://localhost:8080/actuator/health &> /dev/null; then
        echo -e " ${GREEN}✓${NC}"
        break
    fi
    echo -n "."
    sleep 2
    ATTEMPT=$((ATTEMPT + 1))
done

if [ $ATTEMPT -eq $MAX_ATTEMPTS ]; then
    echo -e " ${RED}✗${NC}"
    echo ""
    echo "Application did not start within expected time."
    echo "Check logs with: $COMPOSE_CMD logs"
    exit 1
fi

# Success!
echo ""
echo "================================================"
echo -e "  ${GREEN}✓ Application is running!${NC}"
echo "================================================"
echo ""
echo "🚀 Application URL:  http://localhost:8080"
echo "📊 Health Check:     http://localhost:8080/actuator/health"
echo "📝 API Docs:         http://localhost:8080/swagger-ui.html"
echo "🗃️  Database:         localhost:5432 (postgres)"
echo ""
echo "To view logs:  $COMPOSE_CMD logs -f"
echo "To stop:       ./stop.sh"
echo ""
