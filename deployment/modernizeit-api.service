[Unit]
Description=ModernizeIT FastAPI Service
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/modernizeit/modernizeit-api
Environment="PATH=/var/modernizeit/modernizeit-api/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/var/modernizeit/modernizeit-api/.env
ExecStart=/var/modernizeit/modernizeit-api/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=10
StandardOutput=append:/var/log/modernizeit/api.log
StandardError=append:/var/log/modernizeit/api-error.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
