# ModernizeIT API - Production Environment Configuration
# Copy this file to /var/modernizeit/modernizeit-api/.env and fill in values

# ============================================================================
# Application Settings
# ============================================================================
ENV=production
DEBUG=false
API_BASE_URL=https://api.modernizeit.com  # Or your EC2 public IP

# ============================================================================
# Storage Configuration
# ============================================================================
# Storage mode: "local" or "s3"
STORAGE_MODE=s3

# S3 Configuration (when STORAGE_MODE=s3)
S3_BUCKET_ARTIFACTS=modernizeit-artifacts
S3_BUCKET_CUSTOMER_DATA=modernizeit-customer-data
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Local paths (when STORAGE_MODE=local or for fallback)
BASE_LOCAL_PATH=/var/modernizeit/output

# ============================================================================
# AWS Credentials (if not using IAM role)
# ============================================================================
# RECOMMENDED: Use IAM role attached to EC2 instead of these
# If you must use credentials:
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ============================================================================
# Database Configuration
# ============================================================================
# Data Provider: "dynamodb", "sqlite", or "mongodb" (default: dynamodb)
DATA_PROVIDER=dynamodb

# DynamoDB Configuration (RECOMMENDED for production)
DYNAMODB_TABLE_NAME=modernizeit-dev-data
ACCOUNT_ID=341

# SQLite (alternative - not recommended for multi-tenant)
# DATA_PROVIDER=sqlite
# SQLITE_DB_PATH=/var/modernizeit/modernizeit-api/db/jobs.db

# MongoDB (alternative)
# DATA_PROVIDER=mongodb
# MONGODB_URI=mongodb://localhost:27017/modernizeit
# MONGODB_DATABASE=modernizeit

# ============================================================================
# Claude AI / Bedrock Configuration
# ============================================================================
# Bedrock model configuration
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_REGION=us-east-1

# ============================================================================
# API Settings
# ============================================================================
# CORS origins (comma-separated)
ALLOWED_ORIGINS=https://portal.modernizeit.com,http://localhost:5175

# API rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/modernizeit/api.log

# ============================================================================
# MCP Server Settings
# ============================================================================
MCP_OUTPUT_DIR=/var/modernizeit/mcp_servers
MCP_S3_BUCKET=modernizeit-artifacts
MCP_S3_PREFIX=mcp_servers

# ============================================================================
# Security
# ============================================================================
# JWT secret for authentication (generate with: openssl rand -hex 32)
# JWT_SECRET=your_secret_key_here

# API key for admin operations (generate with: openssl rand -hex 32)
# ADMIN_API_KEY=your_admin_key_here
